# ---------------------------------------------------------------------------
#  Настройки запуска historian2grafana в Docker.
#  Скопируйте этот файл в .env (рядом с docker-compose.yml) и поменяйте
#  пароли. Без .env всё тоже запустится — с паролями по умолчанию.
#
#  Подключение к историку здесь НЕ задаётся: его вводят в браузере на
#  странице «Подключение».
# ---------------------------------------------------------------------------

# Порты на этом компьютере: приложение и Grafana
APP_PORT=8000
GRAFANA_PORT=3000

# Порт базы данных — только для комплекта без Docker (start.bat). Другой,
# чем 5432, чтобы не мешать PostgreSQL, если он уже установлен
DB_PORT=55432

# Пароль базы данных приложения. Действует при ПЕРВОМ запуске: потом база
# уже создана с этим паролем (сменить — см. docs/INSTALL.md, раздел 11)
DB_PASSWORD=historian

# Пароль учётной записи, под которой Grafana читает базу (только чтение)
GRAFANA_DB_PASSWORD=grafana_reader

# Вход в Grafana для правки дашбордов (смотреть графики можно без входа).
# Действует при первом запуске Grafana
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# Часовой пояс для журналов контейнера (на графики не влияет: они
# показываются во времени вашего браузера)
TZ=Europe/Moscow

# 1 — разрешить устаревшее шифрование (TLS 1.0/1.1) при подключении к
# SQL Server историка. Включайте, только если проверка подключения пишет об
# ошибке SSL/TLS
HISTORIAN_OLD_TLS=0

# Если Grafana открывают по другому адресу (не «этот же компьютер:GRAFANA_PORT»),
# укажите его для ссылок из приложения, например http://10.20.30.50:3000
GRAFANA_URL=

# Подробность журналов приложения: INFO или DEBUG
LOG_LEVEL=INFO
