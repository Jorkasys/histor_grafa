# Настройки OpenSSL для старых серверов SQL Server (только TLS 1.0/1.1 или
# сертификат с подписью SHA-1). Включаются флагом HISTORIAN_OLD_TLS=1 в .env.
openssl_conf = openssl_init

[openssl_init]
ssl_conf = ssl_sect

[ssl_sect]
system_default = system_default_sect

[system_default_sect]
MinProtocol = TLSv1
CipherString = DEFAULT@SECLEVEL=0
